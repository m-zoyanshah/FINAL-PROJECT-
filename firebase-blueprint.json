{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "PdfTask": {
      "title": "PdfTask",
      "description": "Log of a PDF task performed by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "tool": { "type": "string", "enum": ["merge", "split", "compress", "pdf-to-word"] },
        "fileName": { "type": "string" },
        "fileCount": { "type": "number" },
        "fileSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "tool", "fileName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/PdfTask" },
      "description": "Subcollection of PDF processing tasks for each user"
    }
  }
}
